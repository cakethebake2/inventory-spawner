-- Helper to create an item card
local function createItemCard(item)
	local card = Instance.new("Frame")
	card.Name = "ItemCard_" .. tostring(item.id)
	card.Size = UDim2.new(0, 120, 0, 140)
	card.BackgroundColor3 = Color3.fromRGB(34,34,38)
	card.BorderSizePixel = 0

	local cardCorner = Instance.new("UICorner", card)
	cardCorner.CornerRadius = UDim.new(0, 8)

	local img = Instance.new("ImageLabel", card)
	img.Name = "Icon"
	img.Size = UDim2.new(0, 96, 0, 96)
	img.Position = UDim2.new(0.5, -48, 0, 8)
	img.BackgroundTransparency = 1
	img.Image = item.image or ""
	img.ScaleType = Enum.ScaleType.Fit

	local nameLabel = Instance.new("TextLabel", card)
	nameLabel.Name = "Name"
	nameLabel.Size = UDim2.new(1, -8, 0, 34)
	nameLabel.Position = UDim2.new(0, 4, 1, -38)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = item.name
	nameLabel.Font = Enum.Font.Gotham
	nameLabel.TextSize = 14
	nameLabel.TextColor3 = Color3.fromRGB(235,235,235)
	nameLabel.TextWrapped = true
	nameLabel.TextYAlignment = Enum.TextYAlignment.Top

	-- Equipped badge
	local badge = Instance.new("TextLabel", card)
	badge.Name = "Badge"
	badge.Size = UDim2.new(0, 60, 0, 20)
	badge.Position = UDim2.new(1, -64, 0, 8)
	badge.BackgroundColor3 = Color3.fromRGB(75, 180, 120)
	badge.Text = "Equipped"
	badge.Font = Enum.Font.GothamBold
	badge.TextSize = 12
	badge.TextColor3 = Color3.fromRGB(20,20,20)
	badge.Visible = false
	local badgeCorner = Instance.new("UICorner", badge)
	badgeCorner.CornerRadius = UDim.new(0, 6)

	-- Click area (ImageButton overlay)
	local clickArea = Instance.new("TextButton", card)
	clickArea.Name = "Click"
	clickArea.Size = UDim2.new(1, 0, 1, 0)
	clickArea.BackgroundTransparency = 1
	clickArea.Text = ""
	clickArea.AutoButtonColor = false

	-- Hover handling for tooltip
	clickArea.MouseEnter:Connect(function()
		ttLabel.Text = string.format("%s\n\n%s\nRarity: %s", item.name, item.desc or "", item.rarity or "Unknown")
		tooltip.Visible = true
		local mouse = player:GetMouse()
		local x = mouse.X
		local y = mouse.Y
		tooltip.Position = UDim2.new(0, x + 16, 0, y + 16)
		-- small fade in
		tooltip.BackgroundTransparency = 1
		TweenService:Create(tooltip, TweenInfo.new(0.12), {BackgroundTransparency = 0}):Play()
	end)

	clickArea.MouseMoved:Connect(function(x, y)
		tooltip.Position = UDim2.new(0, x + 16, 0, y + 16)
	end)

	clickArea.MouseLeave:Connect(function()
		-- fade out
		TweenService:Create(tooltip, TweenInfo.new(0.08), {BackgroundTransparency = 1}):Play()
		delay(0.09, function()
			tooltip.Visible = false
		end)
	end)

	-- Toggle equip on click (client-only)
	clickArea.MouseButton1Click:Connect(function()
		local already = equipped[item.id]
		if already then
			equipped[item.id] = nil
			badge.Visible = false
			-- visual feedback
			TweenService:Create(card, TweenInfo.new(0.14), {BackgroundColor3 = Color3.fromRGB(34,34,38)}):Play()
		else
			equipped[item.id] = true
			badge.Visible = true
			-- highlight
			TweenService:Create(card, TweenInfo.new(0.14), {BackgroundColor3 = Color3.fromRGB(54,34,48)}):Play()
		end
	end)

	return card
end

-- Populate items
local function populate(items)
	-- Clear existing
	for _, child in ipairs(scroll:GetChildren()) do
		if not child:IsA("UIGridLayout") then
			child:Destroy()
		end
	end

	for _, item in ipairs(items) do
		local card = createItemCard(item)
		card.Parent = scroll
	end

	-- update canvas size
	wait() -- allow layout to run
	local contentHeight = grid.AbsoluteContentSize.Y
	scroll.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
end

-- Filter helper
local function filterItems(query)
	query = (query or ""):lower()
	if query == "" then
		return sampleItems
	end
	local out = {}
	for _, it in ipairs(sampleItems) do
		if string.find(it.name:lower(), query, 1, true) or string.find((it.rarity or ""):lower(), query, 1, true) then
			table.insert(out, it)
		end
	end
	return out
end

-- Hook search
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local q = searchBox.Text
	populate(filterItems(q))
end)

-- Close button
closeBtn.MouseButton1Click:Connect(function()
	main.Visible = false
end)

-- Make GUI draggable
local dragging = false
local dragStart = nil
local startPos = nil

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

titleBar.InputChanged:Connect(function(input)
	-- no-op
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Initial populate
populate(sampleItems)

