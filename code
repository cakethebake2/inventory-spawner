-- // Helper to check if an item name matches any high-value keyword
local function isHighValue(itemName)
    for _, keyword in ipairs(highValueItems) do
        if string.find(itemName, keyword, 1, true) then
            return true
        end
    end
    return false
end

-- // Function to create a button for an item
local function createItemButton(itemName, itemIcon)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -10, 0, 40)
    button.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    button.Text = ""
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.ClipsDescendants = true

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 4)
    buttonCorner.Parent = button

    -- // High-value highlight
    if isHighValue(itemName) then
        button.BackgroundColor3 = Color3.fromRGB(75, 50, 25) -- Gold/Bronze tint
        local glow = Instance.new("UIGradient")
        glow.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 215, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 140, 0))
        }
        glow.Rotation = 45
        glow.Parent = button
    end

    local iconLabel = Instance.new("ImageLabel")
    iconLabel.Size = UDim2.new(0, 30, 0, 30)
    iconLabel.Position = UDim2.new(0, 5, 0, 5)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Image = itemIcon or "rbxassetid://0"
    iconLabel.Parent = button

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -50, 1, 0)
    nameLabel.Position = UDim2.new(0, 40, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = itemName
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.Gotham
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = button

    -- // Hover effect
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(75, 75, 75) }):Play()
    end)
    button.MouseLeave:Connect(function()
        local baseColor = isHighValue(itemName) and Color3.fromRGB(75, 50, 25) or Color3.fromRGB(55, 55, 55)
        TweenService:Create(button, TweenInfo.new(0.2), { BackgroundColor3 = baseColor }):Play()
    end)

    return button
end

-- // --- IMPROVED SPAWN FUNCTION ---
-- // This function uses multiple methods to try and give the player the item.
local function spawnItem(item)
    if not item then
        warn("[InventorySpawner] Attempted to spawn nil item.")
        return
    end

    local success, result = pcall(function()
        -- // Method 1: Try firing a remote event
        local spawnRemote = ReplicatedStorage:FindFirstChild("SpawnItem") or
                            ReplicatedStorage:FindFirstChild("GiveItem") or
                            ReplicatedStorage:FindFirstChild("RequestItem") or
                            ReplicatedStorage:FindFirstChild("PurchaseItem") or
                            ReplicatedStorage:FindFirstChild("AddItem") or
                            ReplicatedStorage:FindFirstChild("GetItem") or
                            ReplicatedStorage:FindFirstChild("ItemService")

        if spawnRemote and spawnRemote:IsA("RemoteEvent") then
            spawnRemote:FireServer(item)
            return true
        end

        -- // Method 2: Try cloning the item directly
        if item:IsA("Tool") then
            local cloned = item:Clone()
            cloned.Parent = player.Backpack
            return true
        end

        -- // Method 3: Try to give via StarterGear
        if item:IsA("Tool") then
            local cloned = item:Clone()
            cloned.Parent = player:FindFirstChild("StarterGear")
            return true
        end

        -- // Method 4: Force it into the character
        if item:IsA("Tool") and player.Character then
            local cloned = item:Clone()
            cloned.Parent = player.Character
            return true
        end

        -- // Method 5: If it's not a tool, try to put it in the player's backpack anyway
        if not item:IsA("Tool") then
            local cloned = item:Clone()
            cloned.Parent = player.Backpack
            return true
        end

        return false
    end)

    if success and result then
        print("[InventorySpawner] Spawned: " .. item.Name)
    else
        warn("[InventorySpawner] Failed to spawn: " .. item.Name)
    end
end

-- // --- IMPROVED ITEM LOADER ---
-- // Recursively searches all folders in ReplicatedStorage for items.
local function loadItems()
    -- // Clear existing items (keep the UIListLayout)
    for _, child in pairs(itemList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local searchText = searchBox.Text:lower()
    local itemCache = {} -- // To avoid duplicates

    -- // Recursive function to search for tools and other spawnable items
    local function searchFolder(folder, path)
        for _, child in pairs(folder:GetChildren()) do
            if child:IsA("Folder") or child:IsA("Model") then
                -- // Recurse into subfolders
                searchFolder(child, path .. child.Name .. "/")
            elseif child:IsA("Tool") or child:IsA("Part") or child:IsA("MeshPart") or child:IsA("BasePart") then
                -- // Check if it's a valid item
                local itemName = child.Name
                if not itemCache[itemName] then
                    if searchText == "" or string.find(string.lower(itemName), searchText, 1, true) then
                        local button = createItemButton(itemName, nil)
                        button.MouseButton1Click:Connect(function()
                            spawnItem(child)
                        end)
                        button.Parent = itemList
                        itemCache[itemName] = true
                    end
                end
            end
        end
    end

    -- // Start searching from ReplicatedStorage
    searchFolder(ReplicatedStorage, "")

    -- // Also check if there are items directly in ReplicatedStorage (not in folders)
    for _, child in pairs(ReplicatedStorage:GetChildren()) do
        if (child:IsA("Tool") or child:IsA("Part") or child:IsA("MeshPart") or child:IsA("BasePart")) and not itemCache[child.Name] then
            local itemName = child.Name
            if searchText == "" or string.find(string.lower(itemName), searchText, 1, true) then
                local button = createItemButton(itemName, nil)
                button.MouseButton1Click:Connect(function()
                    spawnItem(child)
                end)
                button.Parent = itemList
                itemCache[itemName] = true
            end
        end
    end

    print("[InventorySpawner] Loaded " .. #itemList:GetChildren() .. " items.")
end

-- // Connect search functionality
searchBox:GetPropertyChangedSignal("Text"):Connect(loadItems)

