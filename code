local function isHighValue(itemName)
    for _, keyword in ipairs(highValueItems) do
        if string.find(itemName, keyword, 1, true) then
            return true
        end
    end
    return false
end

-- // --- BLACKLIST for non-knife junk ---
local blacklistKeywords = {
    "egg", "coin", "spinning", "visual", "old", "effect", "particle",
    "animation", "sound", "ui", "gui", "texture", "mesh", "decal",
    "light", "sparkle", "glow", "trail", "beam", "circle", "square"
}

local function isBlacklisted(itemName)
    local lower = string.lower(itemName)
    for _, kw in ipairs(blacklistKeywords) do
        if string.find(lower, kw, 1, true) then
            return true
        end
    end
    return false
end

-- // --- Check if an item is a valid knife (Tool and not blacklisted) ---
local function isValidKnife(item)
    if not item:IsA("Tool") then
        -- Sometimes knives are models with a Tool child, check for that
        local tool = item:FindFirstChildWhichIsA("Tool")
        if not tool then return false end
        -- If found, we'll treat the item as the tool itself later
        -- We'll store the tool reference for spawning
        return true
    end
    return not isBlacklisted(item.Name)
end

-- // --- Helper to get the actual Tool object from any container ---
local function getToolFromContainer(container)
    if container:IsA("Tool") then
        return container
    end
    local tool = container:FindFirstChildWhichIsA("Tool")
    return tool
end

-- // --- SPAWN FUNCTION (unchanged logic, but now uses the tool) ---
local function spawnItem(itemContainer)
    local tool = getToolFromContainer(itemContainer)
    if not tool then
        warn("[InventorySpawner] No Tool found in container:", itemContainer.Name)
        return
    end

    local success, result = pcall(function()
        -- Method 1: Try remote events
        local spawnRemote = ReplicatedStorage:FindFirstChild("SpawnItem") or
                            ReplicatedStorage:FindFirstChild("GiveItem") or
                            ReplicatedStorage:FindFirstChild("RequestItem") or
                            ReplicatedStorage:FindFirstChild("PurchaseItem") or
                            ReplicatedStorage:FindFirstChild("AddItem") or
                            ReplicatedStorage:FindFirstChild("GetItem") or
                            ReplicatedStorage:FindFirstChild("ItemService") or
                            ReplicatedStorage:FindFirstChild("BuyKnife")  -- common MM2 remote

        if spawnRemote and spawnRemote:IsA("RemoteEvent") then
            spawnRemote:FireServer(tool)
            return true
        end

        -- Method 2: Clone directly into Backpack
        if tool:IsA("Tool") then
            local cloned = tool:Clone()
            cloned.Parent = player.Backpack
            return true
        end

        -- Method 3: Try StarterGear
        if tool:IsA("Tool") then
            local cloned = tool:Clone()
            cloned.Parent = player:FindFirstChild("StarterGear")
            return true
        end

        -- Method 4: Force into character
        if tool:IsA("Tool") and player.Character then
            local cloned = tool:Clone()
            cloned.Parent = player.Character
            return true
        end

        return false
    end)

    if success and result then
        print("[InventorySpawner] Spawned: " .. tool.Name)
    else
        warn("[InventorySpawner] Failed to spawn: " .. tool.Name)
    end
end

