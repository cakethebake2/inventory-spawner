        TweenService:Create(button, TweenInfo.new(0.2), { BackgroundColor3 = baseColor }):Play()
    end)

    return button
end

-- // --- IMPROVED LOADER (now with unlimited recursion + debug prints) ---
local function loadItems()
    -- Clear existing buttons
    for _, child in pairs(itemList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local searchText = searchBox.Text:lower()
    local added = {}
    local foundCount = 0

    -- Recursive search with no depth limit, but we track visited to avoid infinite loops
    local function scanFolder(folder)
        for _, child in pairs(folder:GetChildren()) do
            -- Check if this child is a knife container (directly)
            local container, displayName = getKnifeInfo(child)
            if container and displayName then
                -- Skip blacklisted names
                if not isBlacklisted(displayName) then
                    if searchText == "" or string.find(string.lower(displayName), searchText, 1, true) then
                        if not added[displayName] then
                            added[displayName] = true
                            local button = createItemButton(displayName)
                            button.MouseButton1Click:Connect(function()
                                spawnItem(container)
                            end)
                            button.Parent = itemList
                            foundCount = foundCount + 1
                        end
                    end
                end
            elseif child:IsA("Folder") or child:IsA("Model") then
                -- Recurse into folders and models (models might contain sub-models or parts)
                scanFolder(child)
            end
        end
    end

    -- Start scanning from ReplicatedStorage
    scanFolder(ReplicatedStorage)

    -- Also check if there is a "Knives" folder anywhere under ReplicatedStorage
    -- Some MM2 versions might have it deeper
    local knifeFolder = ReplicatedStorage:FindFirstChild("Knives")
    if knifeFolder then
        -- Scan it directly (will be scanned anyway via recursion, but we do it explicitly)
        scanFolder(knifeFolder)
    end

    print("[InventorySpawner] Loaded " .. foundCount .. " knives.")
end

