    return button
end

-- // --- IMPROVED LOADER (MM2-focused) ---
local function loadItems()
    -- Clear existing buttons
    for _, child in pairs(itemList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local searchText = searchBox.Text:lower()
    local added = {}
    local foundCount = 0

    -- Find the knife folder (MM2 standard)
    local knifeFolder = ReplicatedStorage:FindFirstChild("Knives")
        or ReplicatedStorage:FindFirstChild("Weapons")
        or ReplicatedStorage:FindFirstChild("Melee")

    local function processContainer(container)
        local _, displayName = getKnifeInfo(container)
        if not displayName then return end

        -- Apply blacklist to display name
        if isBlacklisted(displayName) then return end

        -- Search filter
        if searchText ~= "" and not string.find(string.lower(displayName), searchText, 1, true) then
            return
        end

        -- Avoid duplicates
        if added[displayName] then return end
        added[displayName] = true

        local button = createItemButton(displayName)
        button.MouseButton1Click:Connect(function()
            spawnItem(container)
        end)
        button.Parent = itemList
        foundCount = foundCount + 1
    end

    local function scanFolder(folder, depth)
        if depth > 2 then return end -- limit depth

        for _, child in pairs(folder:GetChildren()) do
            -- If we have a dedicated knife folder, we only scan its direct children
            if knifeFolder then
                -- Direct children of the knife folder are the knife containers
                local container, display = getKnifeInfo(child)
                if container and display then
                    processContainer(container)
                else
                    -- If it's a subfolder, scan inside (but keep depth limit)
                    if child:IsA("Folder") then
                        scanFolder(child, depth + 1)
                    end
                end
            else
                -- Fallback: scan everything, but be strict
                local container, display = getKnifeInfo(child)
                if container and display then
                    -- Extra check: if it's a Model, ensure it has a Tool descendant
                    local tool = container:IsA("Tool") and container or container:FindFirstChildWhichIsA("Tool")
                    if tool then
                        processContainer(container)
                    end
                elseif child:IsA("Folder") then
                    -- Scan subfolders for possible knife models
                    scanFolder(child, depth + 1)
                end
            end
        end
    end

    if knifeFolder then
        print("[InventorySpawner] Found knife folder: " .. knifeFolder.Name)
        scanFolder(knifeFolder, 0)
    else
        print("[InventorySpawner] No dedicated knife folder found. Scanning ReplicatedStorage (strict mode).")
        scanFolder(ReplicatedStorage, 0)
    end

    print("[InventorySpawner] Loaded " .. foundCount .. " knives.")
end

