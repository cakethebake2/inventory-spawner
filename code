-- Minimal client-run test LocalScript
print("[InvTest] script loaded")

local Players = game:GetService("Players")
local player = Players.LocalPlayer

if not player then
    warn("[InvTest] No LocalPlayer found — script may be running on the server. Make sure this is a LocalScript and you're running Play/Start.")
    return
end

print("[InvTest] LocalPlayer:", player.Name)

-- Show a tiny UI to confirm visuals
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "InvTestGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local label = Instance.new("TextLabel")
label.Size = UDim2.new(0,200,0,40)
label.Position = UDim2.new(0,8,0,8)
label.BackgroundColor3 = Color3.fromRGB(50,120,200)
label.TextColor3 = Color3.fromRGB(255,255,255)
label.Text = "InvTest GUI visible"
label.Font = Enum.Font.SourceSansBold
label.TextSize = 18
label.Parent = screenGui

print("[InvTest] GUI created; look top-left of screen for 'InvTest GUI visible'")
