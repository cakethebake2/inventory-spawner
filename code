local function isHighValue(name)
    for _, kw in ipairs(highValueItems) do
        if string.find(name, kw, 1, true) then
            return true
        end
    end
    return false
end

-- // --- BLACKLIST (eggs, coins, visuals, etc.) ---
local blacklistKeywords = {
    "egg", "coin", "spinning", "visual", "old", "effect", "particle",
    "animation", "sound", "ui", "gui", "texture", "mesh", "decal",
    "light", "sparkle", "glow", "trail", "beam", "circle", "square"
}

local function isBlacklisted(name)
    local lower = string.lower(name)
    for _, kw in ipairs(blacklistKeywords) do
        if string.find(lower, kw, 1, true) then
            return true
        end
    end
    return false
end

-- // --- Helper: get the actual knife container and its display name ---
local function getKnifeInfo(item)
    -- If it's a Tool, find its parent Model (if any)
    if item:IsA("Tool") then
        local parent = item.Parent
        if parent and parent:IsA("Model") then
            return parent, parent.Name  -- container, display name
        else
            return item, item.Name      -- standalone tool
        end
    end

    -- If it's a Model, check for a Tool child
    if item:IsA("Model") then
        local tool = item:FindFirstChildWhichIsA("Tool")
        if tool then
            return item, item.Name      -- container, display name
        end
    end

    -- If it's a Part / MeshPart, check if its parent is a Model with a Tool
    if item:IsA("BasePart") or item:IsA("MeshPart") then
        local parent = item.Parent
        if parent and parent:IsA("Model") then
            local tool = parent:FindFirstChildWhichIsA("Tool")
            if tool then
                return parent, parent.Name
            end
        end
    end

    return nil, nil
end

-- // --- SPAWN FUNCTION ---
local function spawnItem(container)
    if not container then return end

    -- Determine the actual tool to give
    local tool = container:IsA("Tool") and container or container:FindFirstChildWhichIsA("Tool")
    if not tool then
        warn("[InventorySpawner] No Tool found in:", container.Name)
        return
    end

    local success, result = pcall(function()
        -- Try remote events (common MM2 remotes)
        local remotes = {
            ReplicatedStorage:FindFirstChild("SpawnItem"),
            ReplicatedStorage:FindFirstChild("GiveItem"),
            ReplicatedStorage:FindFirstChild("RequestItem"),
            ReplicatedStorage:FindFirstChild("PurchaseItem"),
            ReplicatedStorage:FindFirstChild("AddItem"),
            ReplicatedStorage:FindFirstChild("BuyKnife"),
            ReplicatedStorage:FindFirstChild("ItemService")
        }
        for _, remote in ipairs(remotes) do
            if remote and remote:IsA("RemoteEvent") then
                remote:FireServer(tool)
                return true
            end
        end

        -- Direct cloning into Backpack / Character
        local cloned = tool:Clone()
        if player.Backpack then
            cloned.Parent = player.Backpack
        elseif player.Character then
            cloned.Parent = player.Character
        else
            return false
        end
        return true
    end)

    if success and result then
        print("[InventorySpawner] Spawned: " .. container.Name)
    else
        warn("[InventorySpawner] Failed to spawn: " .. container.Name)
    end
end

