        TweenService:Create(button, TweenInfo.new(0.2), { BackgroundColor3 = baseColor }):Play()
    end)

    return button
end

-- // --- IMPROVED ITEM LOADER (focuses on Knives folder) ---
local function loadItems()
    for _, child in pairs(itemList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local searchText = searchBox.Text:lower()
    local itemCache = {}
    local foundItems = {}

    -- // Define possible knife folder names (MM2 often uses "Knives")
    local knifeFolderNames = {"Knives", "Weapons", "Melee", "Tools", "Items"}

    -- // Find the first existing knife folder
    local knifeFolder = nil
    for _, name in ipairs(knifeFolderNames) do
        local folder = ReplicatedStorage:FindFirstChild(name)
        if folder then
            knifeFolder = folder
            break
        end
    end

    -- // If no folder found, fallback to searching all of ReplicatedStorage (but with blacklist)
    local searchRoot = knifeFolder or ReplicatedStorage

    -- // Recursive search function (with depth limit to avoid performance issues)
    local function searchFolder(folder, depth)
        if depth > 3 then return end  -- limit recursion depth
        for _, child in pairs(folder:GetChildren()) do
            if child:IsA("Folder") or child:IsA("Model") then
                searchFolder(child, depth + 1)
            elseif child:IsA("Tool") then
                -- Check if it's a knife (not blacklisted)
                if not isBlacklisted(child.Name) then
                    local itemName = child.Name
                    if not itemCache[itemName] then
                        if searchText == "" or string.find(string.lower(itemName), searchText, 1, true) then
                            local button = createItemButton(itemName, nil)
                            local toolRef = child  -- capture the tool
                            button.MouseButton1Click:Connect(function()
                                spawnItem(toolRef)
                            end)
                            button.Parent = itemList
                            itemCache[itemName] = true
                            table.insert(foundItems, itemName)
                        end
                    end
                end
            elseif child:IsA("Model") or child:IsA("Part") or child:IsA("MeshPart") or child:IsA("BasePart") then
                -- Check if this container holds a Tool child (common for MM2 knives)
                local tool = getToolFromContainer(child)
                if tool and not isBlacklisted(tool.Name) then
                    local itemName = tool.Name
                    if not itemCache[itemName] then
                        if searchText == "" or string.find(string.lower(itemName), searchText, 1, true) then
                            local button = createItemButton(itemName, nil)
                            local containerRef = child  -- capture the container
                            button.MouseButton1Click:Connect(function()
                                spawnItem(containerRef)
                            end)
                            button.Parent = itemList
                            itemCache[itemName] = true
                            table.insert(foundItems, itemName)
                        end
                    end
                end
            end
        end
    end

    searchFolder(searchRoot, 0)

    print("[InventorySpawner] Loaded " .. #foundItems .. " knives.")
end

