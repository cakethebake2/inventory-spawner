-- Item template function
local function createItemButton(itemName, itemIcon)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -10, 0, 40)
    button.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    button.Text = ""
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 4)
    buttonCorner.Parent = button
    
    local iconLabel = Instance.new("ImageLabel")
    iconLabel.Size = UDim2.new(0, 30, 0, 30)
    iconLabel.Position = UDim2.new(0, 5, 0, 5)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Image = itemIcon or "rbxassetid://0"
    iconLabel.Parent = button
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -50, 1, 0)
    nameLabel.Position = UDim2.new(0, 40, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = itemName
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.Gotham
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = button
    
    -- Hover effect
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(75, 75, 75)
        }):Play()
    end)
    
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        }):Play()
    end)
    
    return button
end

-- Function to spawn items
local function spawnItem(itemPath)
    local item = ReplicatedStorage:FindFirstChild(itemPath)
    if item then
        -- Try to find remote events for spawning
        local spawnRemote = ReplicatedStorage:FindFirstChild("SpawnItem") or 
                           ReplicatedStorage:FindFirstChild("GiveItem") or
                           ReplicatedStorage:FindFirstChild("RequestItem")
        
        if spawnRemote and spawnRemote:IsA("RemoteEvent") then
            spawnRemote:FireServer(item)
        else
            -- Try to clone the item directly if it's a tool
            if item:IsA("Tool") then
                local clonedItem = item:Clone()
                clonedItem.Parent = player.Backpack
            end
        end
    end
end

-- Load items from ReplicatedStorage
local function loadItems()
    -- Clear existing items
    for _, child in pairs(itemList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local searchText = searchBox.Text:lower()
    
    -- Search through common folders
    local foldersToCheck = {
        "Items",
        "Tools", 
        "Weapons",
        "Inventory",
        "SpawnableItems",
        "GameItems"
    }
    
    for _, folderName in pairs(foldersToCheck) do
        local folder = ReplicatedStorage:FindFirstChild(folderName)
        if folder then
            for _, item in pairs(folder:GetChildren()) do
                if searchText == "" or item.Name:lower():find(searchText) then
                    local button = createItemButton(item.Name, nil)
                    button.MouseButton1Click:Connect(function()
                        spawnItem(folderName .. "/" .. item.Name)
                    end)
                    button.Parent = itemList
                end
            end
        end
    end
    
    -- Also check for items directly in ReplicatedStorage
    for _, item in pairs(ReplicatedStorage:GetChildren()) do
        if item:IsA("Tool") and (searchText == "" or item.Name:lower():find(searchText)) then
            local button = createItemButton(item.Name, nil)
            button.MouseButton1Click:Connect(function()
                spawnItem(item.Name)
            end)
            button.Parent = itemList
        end
    end
end

-- Connect search functionality
searchBox:GetPropertyChangedSignal("Text"):Connect(loadItems)

-- Keybind to toggle GUI (RightControl)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.RightControl then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

-- Initial load
mainFrame.Parent = screenGui
loadItems()
